<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geetha Amirtha Varshini Weds Gokul Prakash</title>
<style>
  :root{
    --rose: #ff6f91;
    --deep-rose: #d6336c;
    --gold: #f5c04a;
    --cream: #fff5f0;
    --wine: #5c1a2b;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    font-family: 'Georgia', 'Times New Roman', serif;
    background: linear-gradient(135deg, #2b0a1f 0%, #5c1a2b 35%, #7a1f3d 65%, #2b0a1f 100%);
    background-size: 400% 400%;
    animation: bgShift 18s ease infinite;
    color: var(--cream);
    overflow-x: hidden;
    position: relative;
  }

  @keyframes bgShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* floating hearts background */
  .hearts {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .heart {
    position: absolute;
    bottom: -50px;
    color: rgba(255, 111, 145, 0.55);
    font-size: 22px;
    animation: floatUp linear infinite;
    filter: drop-shadow(0 0 6px rgba(255,111,145,0.6));
  }

  @keyframes floatUp {
    0% { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translateY(-55vh) translateX(20px) rotate(180deg); }
    90% { opacity: 1; }
    100% { transform: translateY(-105vh) translateX(-20px) rotate(360deg); opacity: 0; }
  }

  .sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--gold);
    border-radius: 50%;
    box-shadow: 0 0 8px 2px var(--gold);
    animation: twinkle 2.5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; transform: scale(0.6); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
    padding: 60px 24px 80px;
    text-align: center;
  }

  .ornament {
    font-size: 28px;
    color: var(--gold);
    letter-spacing: 12px;
    margin-bottom: 18px;
    animation: fadeInDown 1.2s ease;
  }

  .save-the-date {
    text-transform: uppercase;
    letter-spacing: 6px;
    font-size: 13px;
    color: var(--gold);
    margin-bottom: 22px;
    animation: fadeInDown 1.2s ease;
  }

  .names {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }

  .name {
    font-family: 'Brush Script MT', 'Segoe Script', cursive;
    font-size: clamp(42px, 9vw, 84px);
    line-height: 1.1;
    background: linear-gradient(90deg, var(--gold), #fff3d6, var(--gold));
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 5s linear infinite, fadeInUp 1.4s ease;
    text-shadow: 0 0 25px rgba(245, 192, 74, 0.35);
  }

  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  .weds {
    position: relative;
    font-size: clamp(18px, 3vw, 26px);
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--rose);
    margin: 10px 0 14px;
    animation: fadeIn 1.6s ease;
  }

  .weds .heart-icon {
    display: inline-block;
    margin: 0 14px;
    color: var(--deep-rose);
    animation: pulseHeart 1.3s ease-in-out infinite;
  }

  @keyframes pulseHeart {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  .subtitle {
    font-size: 15px;
    letter-spacing: 3px;
    color: rgba(255,245,240,0.7);
    text-transform: uppercase;
    margin-bottom: 50px;
    animation: fadeIn 2s ease;
  }

  .divider {
    width: 140px;
    height: 1px;
    margin: 30px auto;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    position: relative;
  }
  .divider::before {
    content: "❦";
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold);
    background: transparent;
    font-size: 20px;
  }

  .countdown-title {
    font-size: clamp(15px, 2.5vw, 20px);
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .countdown-date {
    font-size: 15px;
    color: rgba(255,245,240,0.65);
    margin-bottom: 34px;
    letter-spacing: 1px;
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .time-block {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(245,192,74,0.35);
    border-radius: 16px;
    padding: 22px 18px;
    min-width: 100px;
    backdrop-filter: blur(6px);
    box-shadow: 0 0 25px rgba(214,51,108,0.25), inset 0 0 20px rgba(245,192,74,0.05);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .time-block:hover {
    transform: translateY(-6px) scale(1.04);
    box-shadow: 0 10px 30px rgba(214,51,108,0.4), inset 0 0 20px rgba(245,192,74,0.1);
  }

  .time-block::after {
    content: "";
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(245,192,74,0.12) 0%, transparent 60%);
    animation: rotateGlow 8s linear infinite;
  }

  @keyframes rotateGlow {
    to { transform: rotate(360deg); }
  }

  .time-value {
    font-size: clamp(32px, 6vw, 48px);
    font-weight: bold;
    color: var(--gold);
    font-family: 'Courier New', monospace;
    text-shadow: 0 0 18px rgba(245,192,74,0.6);
    position: relative;
    z-index: 1;
  }

  .time-value.seconds {
    color: var(--rose);
    text-shadow: 0 0 18px rgba(255,111,145,0.7);
  }

  .time-label {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,245,240,0.6);
    margin-top: 6px;
    position: relative;
    z-index: 1;
  }

  .quote {
    font-style: italic;
    font-size: clamp(15px, 2.2vw, 19px);
    color: rgba(255,245,240,0.85);
    max-width: 520px;
    margin: 40px auto 0;
    line-height: 1.7;
    position: relative;
  }

  .quote::before, .quote::after {
    color: var(--gold);
    font-size: 26px;
    vertical-align: -6px;
  }

  .footer-hearts {
    margin-top: 50px;
    font-size: 22px;
    color: var(--rose);
    letter-spacing: 14px;
    animation: pulseHeart 2s ease-in-out infinite;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .ampersand {
    display:none;
  }

  @media (max-width: 480px) {
    .countdown { gap: 10px; }
    .time-block { min-width: 76px; padding: 16px 10px; }
  }
</style>
</head>
<body>

<div class="hearts" id="hearts"></div>

<div class="container">
  <div class="ornament">✦ ❈ ✦</div>
  <div class="save-the-date">Save the Date</div>

  <div class="names">
    <div class="name">Geetha Amirtha Varshini</div>
    <div class="weds"><span class="heart-icon">&#10084;</span>WEDS<span class="heart-icon">&#10084;</span></div>
    <div class="name">Gokul Prakash</div>
  </div>

  <div class="subtitle">Two hearts, one journey begins</div>

  <div class="divider"></div>

  <div class="countdown-title">Counting down to forever</div>
  <div class="countdown-date">15th November 2026</div>

  <div class="countdown">
    <div class="time-block">
      <div class="time-value" id="days">00</div>
      <div class="time-label">Days</div>
    </div>
    <div class="time-block">
      <div class="time-value" id="hours">00</div>
      <div class="time-label">Hours</div>
    </div>
    <div class="time-block">
      <div class="time-value" id="minutes">00</div>
      <div class="time-label">Minutes</div>
    </div>
    <div class="time-block">
      <div class="time-value seconds" id="seconds">00</div>
      <div class="time-label">Seconds</div>
    </div>
  </div>

  <div class="divider"></div>

  <p class="quote">Being deeply loved by someone gives you strength, while loving someone deeply gives you courage.</p>

  <div class="footer-hearts">&#10084; &#10084; &#10084;</div>
</div>

<script>
  // Countdown target: Nov 15, 2026, 00:00:00 local time
  const targetDate = new Date("2026-11-15T00:00:00").getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      document.getElementById("days").textContent = "00";
      document.getElementById("hours").textContent = "00";
      document.getElementById("minutes").textContent = "00";
      document.getElementById("seconds").textContent = "00";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("days").textContent = String(days).padStart(2, "0");
    document.getElementById("hours").textContent = String(hours).padStart(2, "0");
    document.getElementById("minutes").textContent = String(minutes).padStart(2, "0");
    document.getElementById("seconds").textContent = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);

  // floating hearts generator
  const heartsContainer = document.getElementById("hearts");
  const heartSymbols = ["&#10084;", "&#10084;", "❈", "✦"];

  function spawnHeart() {
    const heart = document.createElement("div");
    heart.classList.add("heart");
    heart.innerHTML = heartSymbols[Math.floor(Math.random() * heartSymbols.length)];
    heart.style.left = Math.random() * 100 + "%";
    heart.style.fontSize = (14 + Math.random() * 20) + "px";
    heart.style.animationDuration = (8 + Math.random() * 10) + "s";
    heartsContainer.appendChild(heart);
    setTimeout(() => heart.remove(), 18000);
  }

  for (let i = 0; i < 12; i++) {
    setTimeout(spawnHeart, i * 800);
  }
  setInterval(spawnHeart, 1200);

  // sparkles
  function spawnSparkle() {
    const s = document.createElement("div");
    s.classList.add("sparkle");
    s.style.left = Math.random() * 100 + "%";
    s.style.top = Math.random() * 100 + "%";
    s.style.animationDelay = (Math.random() * 2) + "s";
    heartsContainer.appendChild(s);
    setTimeout(() => s.remove(), 5000);
  }
  setInterval(spawnSparkle, 400);
</script>

</body>
</html>
